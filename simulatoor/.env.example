# MQTT broker the simulator publishes telemetry to.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=lora

# Number of virtual LoRa sensor nodes to simulate.
NODE_COUNT=6

# How often each node publishes a reading, in milliseconds.
PUBLISH_INTERVAL_MS=4000

# "random" periodically spikes one node's temperature/gas readings to exercise
# the backend's alert logic; "off" disables simulated alert episodes entirely.
ALERT_MODE=random
ALERT_PROBABILITY=0.35
ALERT_CHECK_INTERVAL_MS=45000
