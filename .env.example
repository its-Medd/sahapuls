# Variables consumed by docker-compose.yml. Copy this file to `.env` to
# override any of the defaults baked into docker-compose.yml.
#
# For local (non-Docker) development, each package has its own .env.example
# instead: simulator/.env.example, server/.env.example, web/.env.example.

# Number of virtual sensor nodes the simulator container publishes.
NODE_COUNT=6

# How often each node publishes a reading, in milliseconds.
PUBLISH_INTERVAL_MS=4000

# "random" periodically raises a simulated alert episode on one node; "off" disables it.
ALERT_MODE=random
ALERT_PROBABILITY=0.35
SCENARIO=random

# Origin the backend allows to call the REST API / connect over Socket.IO.
CORS_ORIGIN=http://localhost:5173

# Base URL baked into the web container's build so the browser can reach the API.
VITE_API_URL=http://localhost:4000
