{
  "name": "@iot-lora-dashboard/web",
  "version": "1.0.0",
  "private": true,
  "description": "React + TypeScript real-time dashboard for the simulated LoRa sensor fleet.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
