# HTTP port for the REST API + Socket.IO server.
PORT=4000

# MQTT broker to subscribe to.
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=lora

# SQLite database file. The directory is created automatically if missing.
DB_PATH=./data/dashboard.sqlite

# Origin allowed to call the REST API / connect over Socket.IO (the Vite dev server by default).
CORS_ORIGIN=http://localhost:5173
