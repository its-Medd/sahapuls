{
  "name": "@sahapul/simulator",
  "version": "1.0.0",
  "private": true,
  "description": "Synthetic LoRa sensor node telemetry generator that publishes readings over MQTT.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "mqtt": "^5.10.3",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^5.1.0",
    "vite": "^8.3.6",
    "@types/node": "^22.0.0"
  }
}
